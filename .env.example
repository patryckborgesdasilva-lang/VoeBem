# Supabase — pega no painel: Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SerpAPI — pega em serpapi.com/dashboard
SERPAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Z-API — pega no painel da Z-API após conectar o WhatsApp
ZAPI_INSTANCE=xxxxxxxxxx
ZAPI_TOKEN=xxxxxxxxxx

# Decolar Afiliados — ID do seu programa de afiliados
DECOLAR_AFFILIATE_ID=SEU_ID_AQUI

# URL do seu site (sem barra no final)
BASE_URL=https://voabem.com.br

# Segredo do cron — qualquer string aleatória, ex: openssl rand -hex 32
CRON_SECRET=gere_uma_string_aleatoria_aqui
